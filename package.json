{
  "name": "hydra-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify + Knex service using hexagonal architecture",
  "main": "dist/index.mjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx tsx src/index.ts --watch",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "lint": "eslint . --ext .ts --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "migrate": "npx knex --knexfile src/infrastructure/db/knexfile.ts migrate:latest",
    "rollback": "npx knex --knexfile src/infrastructure/db/knexfile.ts migrate:rollback"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@keltoi/hydra-ts": "^1.1.14",
    "@types/node": "~24",
    "@typescript-eslint/parser": "~8.59.0",
    "@vitest/coverage-v8": "~4.1.4",
    "@vitest/eslint-plugin": "~1.6.15",
    "better-sqlite3": "^13.0.3",
    "eslint": "~10.2",
    "eslint-config-prettier": "~10.1",
    "globals": "~17.5.0",
    "prettier": "~3.8",
    "rimraf": "~6.1.3",
    "ts-api-utils": "~2.5.0",
    "tsdown": "^0.21.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.59.0",
    "vitest": "~4.1.4"
  }
}
