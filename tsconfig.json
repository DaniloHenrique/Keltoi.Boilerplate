{
  "compilerOptions": {
    /* Build the code with the latest features but target a modern Node runtime  */
    "target": "ES2024",
    "module": "ESNext",
    "lib": ["ES2024"],
    /* Resolve modules like Node (imports by relative path, ‘node_modules’, etc.) */
    "moduleResolution": "bundler",

    /* Entry / output */
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,

    /* Strictness – you’ll catch most bugs at compile time */
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    /* Compatibility helpers / helpers for library code */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "useDefineForClassFields": true,

    /* Node types */
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
